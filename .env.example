# Supabase (필수)
# 대시보드: https://supabase.com/dashboard → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 서버 전용 (관리자·배치용)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (필수) — Google AI Studio 키
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 선택: 사용할 모델 (기본 gemini-2.5-flash-lite, 과부하·404 시 gemini-2.5-flash로 자동 폴백)
# GEMINI_MODEL=gemini-2.5-flash-lite

# 관리자 가입 코드
ADMIN_CODE=

# 슈퍼관리자(본인 구글 계정 이메일)
# SUPER_ADMIN_EMAIL=you@gmail.com
